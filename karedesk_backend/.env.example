# Backend service environment example for Karedesk
# Copy to .env and adjust for your environment. Do NOT commit real secrets.

# Database connection string (PostgreSQL example)
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/karedesk

# SQLAlchemy engine pool size
DB_POOL_SIZE=5

# Log SQL statements (true/false)
DB_ECHO=false
