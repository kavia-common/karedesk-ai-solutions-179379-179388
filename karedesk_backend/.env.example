# API metadata (used by Flask-Smorest docs)
API_TITLE=Karedesk API
API_VERSION=v1

# Allowed CORS origins (comma-separated). Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/karedesk
DB_POOL_SIZE=5
DB_ECHO=false
